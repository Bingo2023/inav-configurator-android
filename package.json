{
  "name": "inav-configurator-android",
  "version": "10.0.0-rc1",
  "private": true,
  "description": "Android-Wrapper f\u00fcr den INAV Configurator (Upstream als Submodule, Shim statt Fork)",
  "license": "GPL-3.0",
  "scripts": {
    "postinstall": "cd inav-configurator && npm install",
    "build:mobile": "vite build --config vite.config.mobile.mjs",
    "sync": "npm run build:mobile && cap sync android",
    "android": "npm run sync && cap open android",
    "update:upstream": "bash scripts/update-upstream.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "vite": "^8.3.1",
    "@rollup/plugin-inject": "^5.0.5"
  }
}
