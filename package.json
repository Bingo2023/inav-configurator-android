{
  "name": "inav-configurator-android",
  "version": "0.1.0",
  "private": true,
  "description": "Android-Wrapper für den INAV Configurator (Upstream als Submodule, Shim statt Fork)",
  "license": "GPL-3.0",
  "scripts": {
    "postinstall": "cd inav-configurator && npm install",
    "build:mobile": "vite build --config vite.config.mobile.mjs",
    "sync": "npm run build:mobile && cap sync android",
    "android": "npm run sync && cap open android",
    "update:upstream": "bash scripts/update-upstream.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "vite": "^5.4.0"
  }
}
